# Polybot — plantilla de configuración local.
# Copiar a .env en la raíz del repositorio y completar:
#   cp docs/env.example .env
# .env nunca se commitea.

APP_ENV=dev
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000

# Orígenes permitidos para la PWA (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Base de datos: SQLite local (ADR-012). Un valor vacío usa el default
# sqlite+aiosqlite:///./polybot.db
DATABASE_URL=

# Tutor (LLM): una instancia de Pi por turno (ADR-013).
# PI_BIN_PATH vacío usa `pi` del PATH; PI_MODEL vacío usa el modelo por defecto del Pi instalado.
PI_BIN_PATH=
PI_MODEL=
PI_TIMEOUT_SECONDS=60

# Voz: entrada (STT) — modelo aún sin validar
STT_PROVIDER=
STT_MODEL=
STT_LANGUAGE=

# Voz: salida (TTS)
TTS_PROVIDER=piper
PIPER_BIN_PATH=
PIPER_VOICE_DIR=
PIPER_DEFAULT_VOICE=

# Límites
MAX_AUDIO_SECONDS=120
MAX_TTS_CHARACTERS=2000
RATE_LIMIT_PER_SESSION=

# Privacidad: persistir audio del usuario (false por defecto)
STORE_USER_AUDIO=false

# Frontend: VITE_API_BASE_URL se define en frontend/.env, porque Vite solo lee ese directorio.
# Default: http://localhost:8000/api/v1
