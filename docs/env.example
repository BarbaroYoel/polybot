# Polybot — plantilla de configuración local.
# Copiar a .env en la raíz del repositorio y completar:
#   cp docs/env.example .env
# .env nunca se commitea.

APP_ENV=dev
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000

# Orígenes permitidos para la PWA (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Base de datos: SQLite local (ADR-012). Un valor vacío usa el default
# sqlite+aiosqlite:///./polybot.db
DATABASE_URL=

# Tutor (LLM): una instancia de Pi por turno (ADR-013).
# PI_BIN_PATH vacío usa `pi` del PATH; PI_MODEL vacío usa el modelo por defecto del Pi instalado.
PI_BIN_PATH=
PI_MODEL=
PI_TIMEOUT_SECONDS=60

# Voz de salida (TTS): Piper por binario y subproceso (ADR-016).
# Vacío usa `piper` del PATH. El binario oficial de Linux se instala una vez:
#   mkdir -p data/piper-bin && curl -L https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_x86_64.tar.gz | tar -xz -C data/piper-bin
#   → el ejecutable queda en data/piper-bin/piper/piper
PIPER_BIN_PATH=

# Voces: un .onnx + .onnx.json por idioma, en data/piper-voices (ADR-016). Vacío usa ese default.
#   https://huggingface.co/rhasspy/piper-voices → es/es_ES/davefx/medium/, fr/fr_FR/siwis/medium/, …
PIPER_VOICES_DIR=

# Caché de audio sintetizado. Vacío usa data/speech.
PIPER_SPEECH_DIR=
PIPER_TIMEOUT_SECONDS=30

# Voz de entrada (STT): Whistle por `cactus-needle` (ADR-015). No tiene configuración propia; el
# motor se carga con el primer request y su caché vive en ~/.cache/huggingface.
# NEEDLE_TELEMETRY=0 lo fija el adaptador (el paquete manda conteos de uso anónimos).

# Privacidad: el audio del usuario no se persiste (F4 S7). No hay variable que lo active.
STORE_USER_AUDIO=false

# Frontend: VITE_API_BASE_URL se define en frontend/.env, porque Vite solo lee ese directorio.
# Default: http://localhost:8000/api/v1
